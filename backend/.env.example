# 3D BHARAT - Environment Configuration Template
# Copy this file to .env and configure local values

# Application Environment (development, staging, production)
ENVIRONMENT=development

# PostgreSQL Connection String (psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/3d_bharat

# Allowed CORS Origins (comma-separated, no wildcards when credentials enabled)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Security - Preservation Write Access Key (Required in production for write/upload endpoints)
PRESERVATION_WRITE_API_KEY=your_secure_random_api_key_here

# Local File Storage Root Path (absolute or relative to backend directory)
STORAGE_LOCAL_ROOT=storage/uploads

# Maximum File Upload Sizes (in bytes)
MAX_MEDIA_FILE_SIZE_BYTES=52428800    # 50 MB
MAX_3D_FILE_SIZE_BYTES=209715200      # 200 MB

# =========================================================
# AI HERITAGE INTELLIGENCE (PHASE 9)
# Provider-Independent Configuration
# =========================================================
# Selected Provider: "openai", "gemini", "ollama", or leave blank for offline capability status
AI_PROVIDER=
AI_MODEL=gpt-4o-mini
AI_API_BASE_URL=
AI_API_KEY=
AI_REQUEST_TIMEOUT=30
AI_MAX_OUTPUT_TOKENS=1000
AI_MAX_RETRIES=2
AI_EMBEDDING_MODEL=all-MiniLM-L6-v2
AI_VECTOR_BACKEND=postgres_jsonb
AI_RATE_LIMIT=60/minute
